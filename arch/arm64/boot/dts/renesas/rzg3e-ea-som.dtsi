/* BL_CONTRAST_PWM-GPIO used as PWM when not used as backlight (which is only for LVDS).
   PA6 Func#10 is GPT1 GTIOC12A, and 12 % 8 is 4, 12//8 is 1 so gpt1_4. The "A" at the end
   indicates if it should be "channel_A" or "channel_B". */
&gpt1_4 {
	pinctrl-0 = <&gpt1_4_pins>;
	pinctrl-names = "default";
	channel = "channel_A";
	status = "okay";
};
