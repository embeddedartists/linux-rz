/dts-v1/;
#include "rzg3e-ea-som-hdmi.dts"

/ {

	/delete-node/ osc25250-clk;

	ov5640_fixed_clk: osc25250-ov-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	ov5640_vdddo_1v8: 1p8v {
		compatible = "regulator-fixed";
		regulator-name = "camera_vdddo";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	ov5640_vdda_2v8: 2p8v {
		compatible = "regulator-fixed";
		regulator-name = "camera_vdda";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	ov5640_vddd_1v5: 1p5v {
		compatible = "regulator-fixed";
		regulator-name = "camera_vddd";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-always-on;
	};
};

&i2c8 { /* I2C-A, "PM" */
	
	/delete-node/ ox01f10_csi2@36;
	
	ov5640_csi2: ov5640_csi2@3c {
		compatible = "ovti,ov5640";
		reg = <0x3c>;
		status = "okay";
		clocks = <&ov5640_fixed_clk>;
		clock-names = "xclk";
		csi_id = <0>;

		AVDD-supply = <&ov5640_vdda_2v8>;
		DVDD-supply = <&ov5640_vddd_1v5>;
		DOVDD-supply = <&ov5640_vdddo_1v8>;

		powerdown-gpios = <&pcal6524_u6 1 GPIO_ACTIVE_HIGH>;  /* CSI0_PWR-CLK */
		reset-gpios = <&pcal6524_u6 0 GPIO_ACTIVE_LOW>;  /* CSI0_RST-DATA */

		mclk = <12000000>;
		mclk_source = <0>;
		mipi_csi;

		port {
			ov5640_to_csi2: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi2_in>;
			};
		};
	};	
};

&csi2_in {
	remote-endpoint = <&ov5640_to_csi2>;
};

